# Frontend (Vite — prefix with VITE_)
VITE_BASE_RPC=https://mainnet.base.org
# Optional — WalletConnect Cloud project (limits apply)
VITE_WC_PROJECT_ID=
# Optional — ERC-7677 paymaster URL (CDP / KYC required)
VITE_PAYMASTER_URL=

# Server-only (Vercel Functions)
TELEGRAM_BOT_TOKEN=
# Base Dashboard → Settings → API Key (in-app spend pings)
BASE_NOTIFICATIONS_API_KEY=
# App URL registered on Base Dashboard (defaults to production)
BASE_APP_URL=https://policyvault-cyan.vercel.app
BASE_RPC=https://mainnet.base.org
